# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Database ----------
# Local MongoDB or a free MongoDB Atlas cluster
MONGO_URI=mongodb://127.0.0.1:27017/tomato

# ---------- Auth ----------
# Use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin panel login
ADMIN_EMAIL=admin@tomato.com
ADMIN_PASSWORD=admin123

# ---------- Client URLs (CORS + Stripe redirects) ----------
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Payments ----------
# Leave empty to run with Cash on Delivery only.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
CURRENCY=usd
DELIVERY_FEE=2

# Seed the 32 demo dishes automatically when the menu is empty
AUTO_SEED=true
